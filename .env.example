# FieldLens — environment variable template
#
# This file IS committed: it only has placeholder values.
# The real .env is NEVER committed (it is in .gitignore).
#
# Whole stack in Docker:
#   cp .env.example .env
#   docker compose up --build
#
# Change every "change_me" value before using this anywhere real.

# --- PostgreSQL ---
POSTGRES_USER=fieldlens
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fieldlens

# Used ONLY when you run the API on your own machine (npm run dev).
# Inside Docker, compose builds its own DATABASE_URL with host "db".
DATABASE_URL=postgresql://fieldlens:change_me_locally@localhost:5432/fieldlens

# --- API auth: two different long random strings ---
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_use_a_long_random_string
JWT_REFRESH_SECRET=change_me_refresh_secret_use_a_different_long_string

# --- MinIO (S3-compatible object storage for inspection images) ---
MINIO_ROOT_USER=fieldlens_minio
MINIO_ROOT_PASSWORD=change_me_locally_minio
MINIO_BUCKET=fieldlens-images

# --- ML service ---
# Used ONLY when the API runs on your own machine. Inside Docker it is http://ml:8000.
ML_SERVICE_URL=http://127.0.0.1:8000

# --- Web dashboard ---
# Origins allowed to call the API (comma separated).
WEB_ORIGINS=http://localhost:5173
# API address as seen by the BROWSER. Baked into the web build (public, no secrets).
VITE_API_URL=http://localhost:3000

# --- Optional: change host ports if something else already uses them ---
# DB_PORT=5432
# API_PORT=3000
# ML_PORT=8000
# WEB_PORT=5173
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
