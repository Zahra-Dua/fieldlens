# FieldLens — environment variable template
#
# Rule: this file (.env.example) IS committed — it has no real secrets, just
# placeholder values so anyone cloning the repo knows what variables exist.
# The actual .env file is NEVER committed (it's in .gitignore).
#
# To use: copy this file to .env and fill in real values.
#   cp .env.example .env

# --- PostgreSQL (used by docker-compose.yml and Prisma) ---
POSTGRES_USER=fieldlens
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fieldlens

# Full connection string Prisma will use (Day 2).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://fieldlens:change_me_locally@localhost:5432/fieldlens
